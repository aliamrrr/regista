# Copy to .env (gitignored) and fill in. Values marked (azd) come from `azd env get-values`.

# ---------- runtime modes ----------
BUS=memory                    # memory | eventhubs
LLM_MODE=template             # template (offline) | cache (replay recorded outputs) | live
TTS_MODE=off                  # off | cache | live
STORE=local                   # local (JSON files) | cosmos
DEMO_ACCESS_CODE=change-me    # required to trigger live model generation from the public demo
DAILY_LLM_BUDGET_USD=5        # above this, the gateway switches to template mode until midnight UTC
LOG_LEVEL=INFO

# ---------- Microsoft Foundry (models) ----------
# Use the endpoint shown in your Foundry project. Confirm which client the Agent Framework
# expects (project endpoint vs Azure OpenAI endpoint) with the microsoft-learn MCP server.
FOUNDRY_PROJECT_ENDPOINT=     # https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_OPENAI_ENDPOINT=        # https://<resource>.openai.azure.com/
MODEL_FAST=gpt-5-mini         # deployment name: Storyteller, VAR judge, Fan Agent
MODEL_SMART=gpt-5-mini        # deployment name: Tactician, recaps (use a stronger model if quota allows)
AZURE_OPENAI_API_KEY=         # leave empty to use Entra ID (az login locally, managed identity in Azure)

# ---------- Event Hubs (azd) ----------
EVENTHUBS_FQDN=               # <namespace>.servicebus.windows.net
EVENTHUB_EVENTS=events
EVENTHUB_TRACKING=tracking
CHECKPOINT_BLOB_URL=          # https://<storage>.blob.core.windows.net/checkpoints

# ---------- Cosmos DB (azd) ----------
COSMOS_ENDPOINT=
COSMOS_DATABASE=regista

# ---------- Azure AI Speech ----------
SPEECH_REGION=swedencentral
SPEECH_KEY=                   # stored as a Container Apps secret in Azure
VOICE_EN=en-GB-RyanNeural     # verify voice names with the voices list API before the demo
VOICE_FR=fr-FR-HenriNeural
VOICE_ES=es-ES-AlvaroNeural
VOICE_AR=ar-MA-JamalNeural

# ---------- Azure AI Content Safety ----------
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=

# ---------- Observability (azd) ----------
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=regista-core

# ---------- Managed identity (azd, Azure only) ----------
AZURE_CLIENT_ID=

# ---------- Web (Vite) ----------
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000
CORS_ORIGINS=http://localhost:5173
